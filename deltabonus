<style>
/* ===== ТЕМА И БАЗА ===== */
:root{
  --bg:#eef3f8;
  --card:#ffffff;
  --text:#2a2f36;
  --muted:#6b7280;
  --brand:#0ea5e9;    /* акцент */
  --accent:#d32f2f;   /* красный для стикеров */
  --ring:0 0 0 3px rgba(14,165,233,.15);
  --brd:#e6ebf2;
  --chip:#f7fafc;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:radial-gradient(1200px 600px at 10% -10%, #f7fbff 0%, var(--bg) 60%, #e7edf3 100%);
  font-family: "Segoe UI", Arial, sans-serif;
  color:var(--text);
  padding:14px;
}

/* ===== КАРТОЧКА-БЛОК ===== */
.main-block{
  position:relative;
  /* слой фона с лёгким шумом и отблеском */
  background:
    radial-gradient(120% 120% at 120% -20%, rgba(14,165,233,.10) 0%, rgba(14,165,233,0) 45%),
    linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  font-size:14px;
  max-width:420px;
  margin:16px auto;
  padding:14px;
  border-radius:18px;
  border:1px solid var(--brd);
  box-shadow:
    0 12px 30px rgba(16,24,40,.06),
    0 2px 6px rgba(16,24,40,.06);
  overflow:hidden;
  isolation:isolate; /* для псевдоэлементов */
}

/* декоративный блик вверху */
.main-block::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, rgba(255,255,255,.6), rgba(255,255,255,0));
  pointer-events:none;
  mix-blend-mode:soft-light;
  opacity:.7;
}

/* ===== ШАПКА БРЕНДА ===== */
.brand-head{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:30px;
  padding:20px 25px 9px;
  border-radius:19px;
  background:linear-gradient(180deg,#ffffff, #f7fbff);
  border:1px dashed #e7ecf3;
}
.bonus-title {
  font-weight: 700;
  font-size: 19px;
  letter-spacing: .4px;
  color: #111827;

}

.sku{
  font-size:12px;
  color:var(--accent);
  font-weight:600;
  letter-spacing:.3px;
  padding:2px 10px;
  background:#fff5f5;
  border:1px solid #ffe0e0;
  border-radius:999px;
}

/* ===== ПИЛЮЛЯ (общий бонус) ===== */

.brand-head.solo{ position:relative; }

.pill{
  position:absolute;
  top:-5px; right:12px;
  background:linear-gradient(180deg, #ef4444, #d32f2f);
  color:#fff;
  font-size:12px;
  font-weight:800;
  padding:1px 12px;
  border-radius:999px;
  box-shadow:0 6px 14px rgba(211,47,47,.35);
  pointer-events:none;
}

/* ===== ЛЕВЫЙ БЕЙДЖ (опционально) ===== */
.left-badge{
  position:absolute;
  left:-126px; /* чтобы выглядывал с левого края */
  top:50%;
  transform:translateY(-50%) rotate(-8deg);
  background:linear-gradient(180deg, #d32f2f, #b91c1c);
  color:#fff;
  font-size:11px;
  font-weight:800;
  padding:6px 14px;
  border-radius:12px;
  box-shadow:0 10px 22px rgba(0,0,0,.20);
  white-space:nowrap;
  letter-spacing:.3px;
  border:1px solid rgba(255,255,255,.25);
}

/* ===== DETAILS / SUMMARY ===== */
details{
  padding:10px 0;
  margin:12px 0;
  border-top:1px solid #eef2f7;
}
summary{
  list-style:none;
  cursor:pointer;
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  padding:8px 10px;
  border-radius:12px;
  font-weight:700;
  color:#0f172a;
  transition:box-shadow .2s, transform .2s, background .2s;
}
summary::-webkit-details-marker{display:none}
summary::after{
  content:"";
  width:10px; height:10px;
  border-right:2px solid #475569; border-bottom:2px solid #475569;
  transform:rotate(45deg) translateY(-1px);
  transition:transform .25s, border-color .25s;
}
details[open] > summary::after{
  transform:rotate(-135deg) translateY(1px);
  border-color:var(--accent);
}
summary:hover{ background:#f8fafc }
summary:active{ transform:translateY(1px) }
details[open]{ border-top-color:#f1f5f9 }

/* ===== СПИСКИ ===== */
ol, ul{list-style:none; margin:0; padding:0}
li{margin-bottom:10px}

/* ===== КАРТОЧКА ТОВАРА ===== */
.card{
  position:relative;
  display:flex;
  gap:12px;
  align-items:flex-start;
  padding:12px;
  background:var(--card);
  border:1px solid var(--brd);
  border-radius:14px;
  box-shadow:0 2px 10px rgba(2,6,23,.04);
  transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
.card:hover{
  transform:translateY(-2px);
  border-color:#dbe4ee;
  box-shadow:0 10px 24px rgba(2,6,23,.08);
}
.thumb{flex:0 0 86px}
.thumb img{
  width:86px; height:64px; object-fit:cover;
  border-radius:10px;
  border:1px solid #eef2f7;
  background:#f8fafc;
}
.item-body{display:flex; flex-direction:column; gap:4px; min-width:0}
.points{font-weight:800; color:#111827}
.meta{color:var(--muted); font-size:12px}
a{color:#0ea5e9; text-decoration:none}
a:hover{text-decoration:underline}

/* ===== НАКЛЕЙКА НА КАРТОЧКЕ ===== */
.sticker{
  position:absolute;
  top:-6px; right:-6px;
  padding:6px 10px;
  font-size:11px; font-weight:800;
  background:linear-gradient(180deg, #ef4444, #d32f2f);
  color:#fff; border-radius:999px;
  box-shadow:0 8px 18px rgba(211,47,47,.35);
  pointer-events:none;
}

/* ===== ФИЛЬТРЫ (без JS) ===== */
.controls{
  display:flex; flex-wrap:wrap; gap:10px; align-items:center;
  margin:14px 0 10px;
}
.controls .title{color:#475569; font-size:12px; margin-right:2px}
input[type="radio"]{display:none}
.chip{
  display:inline-block; padding:8px 14px; font-size:13px; font-weight:600;
  border:1px solid var(--brd); border-radius:999px; background:var(--chip);
  transition:all .2s ease; user-select:none; cursor:pointer;
}
input[type="radio"]:checked + label.chip{
  border-color:#94d9f6; background:#eefaff; color:#0369a1; box-shadow:var(--ring);
}

/* ===== КАМЕРЫ (CSS-фильтр по data-атрибутам) ===== */
